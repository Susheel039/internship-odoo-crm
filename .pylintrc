# pylint-odoo: only Odoo-specific checks. Style and generic Python checks are ruff's job.
[MASTER]
load-plugins = pylint_odoo
score = no

[ODOOLINT]
valid-odoo-versions = 19.0
manifest-required-authors = Internship CRM
manifest-required-keys = license
license-allowed = LGPL-3

[MESSAGES CONTROL]
disable = all
enable =
    # Correctness and security
    sql-injection,
    invalid-commit,
    missing-return,
    method-required-super,
    no-write-in-compute,
    external-request-timeout,
    context-overridden,
    print-used,
    except-pass,
    # Translations: every user-facing string goes through _()
    translation-required,
    translation-field,
    translation-positional-used,
    translation-format-interpolation,
    translation-not-lazy,
    # Fields and methods
    method-compute,
    method-inverse,
    method-search,
    renamed-field-parameter,
    attribute-deprecated,
    # Manifests
    manifest-required-author,
    manifest-required-key,
    manifest-version-format,
    manifest-deprecated-key,
    manifest-maintainers-list,
    license-allowed,
    resource-not-exist,
    test-folder-imported

[REPORTS]
output-format = colorized
