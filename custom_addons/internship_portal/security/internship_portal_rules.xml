<?xml version="1.0" encoding="utf-8"?>
<!-- Portal users (students and line managers) read only their own placements and related records.
     Writes go through the portal controllers, which check ownership first. -->
<odoo>
    <record id="rule_placement_portal" model="ir.rule">
        <field name="name">internship.placement: portal users (own placements)</field>
        <field name="model_id" ref="internship_placement.model_internship_placement"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('line_manager_id.user_id', '=', user.id)]</field>
    </record>
