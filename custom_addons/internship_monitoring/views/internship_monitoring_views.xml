<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_attendance_tree" model="ir.ui.view">
        <field name="name">internship.attendance.tree</field>
        <field name="model">internship.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="placement_id" optional="show"/>
                <field name="opportunity_id" optional="hide"/>
                <field name="attendance_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_internship_attendance_form" model="ir.ui.view">
        <field name="name">internship.attendance.form</field>
        <field name="model">internship.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="placement_id"/>
                            <field name="opportunity_id"/>
                            <field name="attendance_date"/>
                            <field name="monthly_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internship_performance_tree" model="ir.ui.view">
        <field name="name">internship.performance.tree</field>
        <field name="model">internship.performance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="opportunity_id"/>
                <field name="review_date"/>
                <field name="score"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_internship_performance_form" model="ir.ui.view">
        <field name="name">internship.performance.form</field>
        <field name="model">internship.performance</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="placement_id"/>
                            <field name="opportunity_id"/>
                            <field name="review_date"/>
                            <field name="review_kind"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="status"/>
                            <field name="supervisor_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                    <field name="comments"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internship_meeting_tree" model="ir.ui.view">
        <field name="name">internship.meeting.tree</field>
        <field name="model">internship.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="meeting_date"/>
                <field name="title" optional="show"/>
                <field name="student_id"/>
                <field name="placement_id" optional="show"/>
                <field name="meeting_type"/>
                <field name="trigger" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_internship_meeting_form" model="ir.ui.view">
        <field name="name">internship.meeting.form</field>
        <field name="model">internship.meeting</field>
        <field name="arch" type="xml">
            <form string="Internship Meeting">
                <header>
                    <button name="action_sync_calendar" type="object" string="Add to Calendar" invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object" string="Mark Held" class="btn-primary"
                            invisible="state not in ('scheduled', 'rescheduled')"/>
                    <button name="action_reschedule" type="object" string="Reschedule" invisible="state != 'scheduled'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Escalation" bg_color="text-bg-danger" invisible="trigger == 'manual'"/>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Meeting title"/></h1>
                        <field name="name" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="placement_id"/>
                            <field name="student_id"/>
                            <field name="opportunity_id" invisible="placement_id"/>
                            <field name="company_id" invisible="placement_id"/>
                            <field name="meeting_type"/>
                        </group>
                        <group>
                            <field name="meeting_date"/>
                            <field name="duration_minutes"/>
                            <field name="video_url" widget="url"/>
                            <field name="calendar_event_id"/>
                            <field name="follow_up_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="trigger == 'manual'">
                        <field name="trigger"/>
                        <field name="trigger_reason"/>
                        <field name="monthly_id"/>
                    </group>
                    <notebook>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                    <field name="attendance_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Minutes" name="minutes">
                            <group>
                                <field name="summary"/>
                                <field name="next_action"/>
                                <field name="additional_docs_needed"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_internship_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">internship.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_performance" model="ir.actions.act_window">
        <field name="name">Performance</field>
        <field name="res_model">internship.performance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">internship.meeting</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
    <menuitem id="menu_internship_attendance" name="Daily Attendance" parent="internship_base.menu_internship_monitoring_main" action="action_internship_attendance" sequence="30"/>
    <menuitem id="menu_internship_performance" name="Performance" parent="internship_base.menu_internship_monitoring_main" action="action_internship_performance" sequence="35"/>
    <menuitem id="menu_internship_meetings" name="Meetings" parent="internship_base.menu_internship_monitoring_main" action="action_internship_meeting" sequence="20"/>
</odoo>
