<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_attendance_tree" model="ir.ui.view">
        <field name="name">internship.attendance.tree</field>
        <field name="model">internship.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="opportunity_id"/>
                <field name="attendance_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_internship_attendance_form" model="ir.ui.view">
        <field name="name">internship.attendance.form</field>
        <field name="model">internship.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="opportunity_id"/>
                            <field name="attendance_date"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_performance_tree" model="ir.ui.view">
        <field name="name">internship.performance.tree</field>
        <field name="model">internship.performance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="opportunity_id"/>
                <field name="review_date"/>
                <field name="score"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_internship_performance_form" model="ir.ui.view">
        <field name="name">internship.performance.form</field>
        <field name="model">internship.performance</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="opportunity_id"/>
                            <field name="review_date"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="status"/>
                            <field name="supervisor_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                    </group>
                    <field name="comments"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_meeting_tree" model="ir.ui.view">
        <field name="name">internship.meeting.tree</field>
        <field name="model">internship.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="opportunity_id"/>
                <field name="meeting_date"/>
                <field name="meeting_type"/>
            </list>
        </field>
    </record>

    <record id="view_internship_meeting_form" model="ir.ui.view">
        <field name="name">internship.meeting.form</field>
        <field name="model">internship.meeting</field>
        <field name="arch" type="xml">
            <form string="Internship Meeting">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="opportunity_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="meeting_date"/>
                            <field name="meeting_type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="summary"/>
                        <field name="next_action"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_internship_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">internship.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_performance" model="ir.actions.act_window">
        <field name="name">Performance</field>
        <field name="res_model">internship.performance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_meeting" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">internship.meeting</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_internship_attendance" name="Attendance" parent="internship_base.menu_internship_monitoring_main" action="action_internship_attendance" sequence="10"/>
    <menuitem id="menu_internship_performance" name="Performance" parent="internship_base.menu_internship_monitoring_main" action="action_internship_performance" sequence="20"/>
    <menuitem id="menu_internship_meetings" name="Meetings" parent="internship_base.menu_internship_monitoring_main" action="action_internship_meeting" sequence="30"/>
</odoo>
