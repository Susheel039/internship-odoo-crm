<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_reason_wizard_form" model="ir.ui.view">
        <field name="name">internship.reason.wizard.form</field>
        <field name="model">internship.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Give a Reason">
                <group>
                    <field name="reason_type" invisible="1"/>
                    <field name="method" invisible="1"/>
                    <field name="reason_required" invisible="1"/>
                    <field name="reason_id" required="reason_required" options="{'no_create': True}"/>
                    <field name="note" placeholder="Details (optional)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_internship_reason_wizard" model="ir.actions.act_window">
        <field name="name">Give a Reason</field>
        <field name="res_model">internship.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
