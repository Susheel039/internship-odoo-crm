<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_expiry_alerts" model="ir.cron">
        <field name="name">Internship: expiry alerts (insurance, pre-approval, RTW, visa)</field>
        <field name="model_id" ref="model_internship_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_alerts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_gdpr_retention" model="ir.cron">
        <field name="name">Internship: GDPR retention review</field>
        <field name="model_id" ref="model_internship_student"/>
        <field name="state">code</field>
        <field name="code">model._cron_gdpr_retention()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
    </record>
</odoo>
