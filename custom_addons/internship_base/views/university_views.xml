<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_university_tree" model="ir.ui.view">
        <field name="name">internship.university.list</field>
        <field name="model">internship.university</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="ukprn" optional="show"/>
                <field name="contact_email"/>
                <field name="phone"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_internship_university_form" model="ir.ui.view">
        <field name="name">internship.university.form</field>
        <field name="model">internship.university</field>
        <field name="arch" type="xml">
            <form string="University">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="University name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="ukprn"/>
                            <field name="partner_id"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group>
                            <field name="contact_email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contacts" name="contacts">
                            <field name="contact_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                    <field name="user_id"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="assigned_student_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Programmes" name="programmes">
                            <field name="program_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="academic_year_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Workflow Defaults" name="rules">
                            <p class="text-muted">Programmes use these values unless they set their own.</p>
                            <group>
                                <group string="Deadlines">
                                    <field name="default_rules_form_due_days"/>
                                    <field name="default_rules_monthly_due_day"/>
                                    <field name="default_rules_monthly_late_grace_days"/>
                                    <field name="default_rules_report_deadline_days"/>
                                    <field name="default_rules_resubmission_days"/>
                                </group>
                                <group string="Thresholds">
                                    <field name="default_rules_max_report_attempts"/>
                                    <field name="default_rules_tripartite_attendance_pct"/>
                                    <field name="default_rules_tripartite_rating_threshold"/>
                                    <field name="default_rules_expiry_alert_days"/>
                                    <field name="default_rules_retention_years"/>
                                </group>
                            </group>
                            <field name="framework_template_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Address and Notes" name="notes">
                            <group>
                                <field name="address"/>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internship_university_search" model="ir.ui.view">
        <field name="name">internship.university.search</field>
        <field name="model">internship.university</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="ukprn"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_internship_university" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">internship.university</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_internship_university" name="Universities" parent="menu_internship_people" action="action_internship_university" sequence="10"/>
</odoo>
