<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.internship_base</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="INTERNTION" string="INTERNTION" name="internship_base" groups="base.group_system">
                    <block title="Workflow defaults" name="internship_rules"
                           help="System-wide fallback when neither the programme nor the university sets a value.">
                        <setting string="Deadlines" help="Form, monthly record and final report deadlines.">
                            <div class="content-group">
                                <div class="row mt8"><label for="internship_rule_form_due_days" class="col-lg-6"/><field name="internship_rule_form_due_days"/></div>
                                <div class="row"><label for="internship_rule_monthly_due_day" class="col-lg-6"/><field name="internship_rule_monthly_due_day"/></div>
                                <div class="row"><label for="internship_rule_monthly_late_grace_days" class="col-lg-6"/><field name="internship_rule_monthly_late_grace_days"/></div>
                                <div class="row"><label for="internship_rule_report_deadline_days" class="col-lg-6"/><field name="internship_rule_report_deadline_days"/></div>
                                <div class="row"><label for="internship_rule_resubmission_days" class="col-lg-6"/><field name="internship_rule_resubmission_days"/></div>
                            </div>
                        </setting>
                        <setting string="Thresholds" help="Escalation, attempts, alerts and data retention.">
                            <div class="content-group">
                                <div class="row mt8"><label for="internship_rule_max_report_attempts" class="col-lg-6"/><field name="internship_rule_max_report_attempts"/></div>
                                <div class="row"><label for="internship_rule_tripartite_attendance_pct" class="col-lg-6"/><field name="internship_rule_tripartite_attendance_pct"/></div>
                                <div class="row"><label for="internship_rule_tripartite_rating_threshold" class="col-lg-6"/><field name="internship_rule_tripartite_rating_threshold"/></div>
                                <div class="row"><label for="internship_rule_expiry_alert_days" class="col-lg-6"/><field name="internship_rule_expiry_alert_days"/></div>
                                <div class="row"><label for="internship_rule_retention_years" class="col-lg-6"/><field name="internship_rule_retention_years"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Communication channels (company)" name="internship_channels"
                           help="The company's shared identity. Users' blank channels use these (Settings › Users › Communication Channels).">
                        <setting string="Email" help="Shared from address and outgoing server.">
                            <div class="content-group">
                                <div class="row mt8"><label for="channel_email_from" class="col-lg-5 o_light_label" string="From Address"/>
                                    <field name="channel_email_from"/></div>
                                <div class="row"><label for="channel_mail_server_id" class="col-lg-5 o_light_label" string="Outgoing Mail Server"/>
                                    <field name="channel_mail_server_id" options="{'no_create': True}"/></div>
                            </div>
                        </setting>
                        <setting string="SMS and WhatsApp" help="Shared sender and business number.">
                            <div class="content-group">
                                <div class="row mt8"><label for="channel_sms_sender" class="col-lg-5 o_light_label" string="SMS Sender"/>
                                    <field name="channel_sms_sender"/></div>
                                <div class="row"><label for="channel_whatsapp_number" class="col-lg-5 o_light_label" string="WhatsApp Number"/>
                                    <field name="channel_whatsapp_number"/></div>
                                <div class="row"><label for="channel_whatsapp_phone_number_id" class="col-lg-5 o_light_label" string="Meta Phone Number ID"/>
                                    <field name="channel_whatsapp_phone_number_id"/></div>
                            </div>
                        </setting>
                        <setting string="Users" help="Per-user channels are on each user's Communication Channels tab.">
                            <button name="%(base.action_res_users)d" type="action" string="Manage Users"
                                    icon="oi-arrow-right" class="btn-link"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_internship_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'internship_base', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_internship_config_settings" name="Settings" parent="menu_internship_config" action="action_internship_settings" sequence="100" groups="base.group_system"/>
</odoo>
