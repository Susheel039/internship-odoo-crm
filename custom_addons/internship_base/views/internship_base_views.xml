<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_university_tree" model="ir.ui.view">
        <field name="name">internship.university.tree</field>
        <field name="model">internship.university</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="contact_email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_internship_university_form" model="ir.ui.view">
        <field name="name">internship.university.form</field>
        <field name="model">internship.university</field>
        <field name="arch" type="xml">
            <form string="University">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="contact_email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address and Notes">
                            <field name="address"/>
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_student_tree" model="ir.ui.view">
        <field name="name">internship.student.tree</field>
        <field name="model">internship.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="university_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_internship_student_form" model="ir.ui.view">
        <field name="name">internship.student.form</field>
        <field name="model">internship.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="university_id"/>
                            <field name="course"/>
                            <field name="department"/>
                            <field name="graduation_year"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_company_tree" model="ir.ui.view">
        <field name="name">internship.company.tree</field>
        <field name="model">internship.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_registration_number"/>
                <field name="industry"/>
                <field name="contact_email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_internship_company_form" model="ir.ui.view">
        <field name="name">internship.company.form</field>
        <field name="model">internship.company</field>
        <field name="arch" type="xml">
            <form string="Company">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="company_registration_number"/>
                            <field name="industry"/>
                            <field name="contact_person"/>
                        </group>
                        <group>
                            <field name="contact_email"/>
                            <field name="phone"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_program_tree" model="ir.ui.view">
        <field name="name">internship.program.tree</field>
        <field name="model">internship.program</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="university_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="application_deadline"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_internship_program_form" model="ir.ui.view">
        <field name="name">internship.program.form</field>
        <field name="model">internship.program</field>
        <field name="arch" type="xml">
            <form string="Internship Program">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="university_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="application_deadline"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_internship_university" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">internship.university</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">internship.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">internship.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_internship_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">internship.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_internship_opportunity_tree" model="ir.ui.view">
        <field name="name">internship.opportunity.tree</field>
        <field name="model">internship.opportunity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="job_title"/>
                <field name="location"/>
                <field name="application_deadline"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_internship_opportunity_form" model="ir.ui.view">
        <field name="name">internship.opportunity.form</field>
        <field name="model">internship.opportunity</field>
        <field name="arch" type="xml">
            <form string="Internship Opportunity">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="program_id"/>
                            <field name="job_title"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="internship_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="application_deadline"/>
                            <field name="number_of_positions"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Skills">
                            <field name="skills_required"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_internship_application_tree" model="ir.ui.view">
        <field name="name">internship.application.tree</field>
        <field name="model">internship.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="company_id"/>
                <field name="application_date"/>
                <field name="interview_date"/>
                <field name="status"/>
                <field name="opportunity_id"/>
            </list>
        </field>
    </record>

    <record id="view_internship_application_form" model="ir.ui.view">
        <field name="name">internship.application.form</field>
        <field name="model">internship.application</field>
        <field name="arch" type="xml">
            <form string="Internship Application">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_review" type="object" string="Start Review" invisible="status != 'submitted'"/>
                    <button name="action_interview" type="object" string="Schedule Interview" invisible="status != 'under_review'"/>
                    <button name="action_offer" type="object" string="Make Offer" invisible="status != 'interview'"/>
                    <button name="action_accept" type="object" string="Accept Offer" class="btn-primary" invisible="status != 'offered'"/>
                    <button name="action_documentation" type="object" string="Begin Onboarding" invisible="status != 'accepted'"/>
                    <button name="action_agreement" type="object" string="Agreement Signed" invisible="status != 'documentation'"/>
                    <button name="action_approve" type="object" string="Approve" invisible="status != 'agreement'"/>
                    <button name="action_place" type="object" string="Mark Placed" class="btn-primary" invisible="status != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status in ['placed', 'rejected', 'cancelled']"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ['placed', 'rejected', 'cancelled']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,under_review,interview,offered,accepted,approved,placed" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="opportunity_id"/>
                            <field name="company_id"/>
                            <field name="university_id"/>
                        </group>
                        <group>
                            <field name="application_date"/>
                            <field name="interview_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Rejection Reason">
                            <field name="rejection_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_internship_opportunity" model="ir.actions.act_window">
        <field name="name">Internship Opportunities</field>
        <field name="res_model">internship.opportunity</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_internship_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">internship.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_internship_root" name="Internship CRM" sequence="10"/>
    <menuitem id="menu_internship_people" name="People" parent="menu_internship_root" sequence="10"/>
    <menuitem id="menu_internship_university" name="Universities" parent="menu_internship_people" action="action_internship_university" sequence="10"/>
    <menuitem id="menu_internship_student" name="Students" parent="menu_internship_people" action="action_internship_student" sequence="20"/>
    <menuitem id="menu_internship_company" name="Companies" parent="menu_internship_people" action="action_internship_company" sequence="30"/>

    <menuitem id="menu_internship_admissions" name="Admissions" parent="menu_internship_root" sequence="20"/>
    <menuitem id="menu_internship_programs" name="Programs" parent="menu_internship_admissions" action="action_internship_program" sequence="10"/>
    <menuitem id="menu_internship_opportunities" name="Internship Opportunities" parent="menu_internship_admissions" action="action_internship_opportunity" sequence="20"/>
    <menuitem id="menu_internship_applications" name="Applications" parent="menu_internship_admissions" action="action_internship_application" sequence="30"/>
</odoo>
