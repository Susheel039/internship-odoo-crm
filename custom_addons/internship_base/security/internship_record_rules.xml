<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_platform_university_all" model="ir.rule">
        <field name="name">Platform administrators: all universities</field>
        <field name="model_id" ref="model_internship_university"/>
        <field name="groups" eval="[(4, ref('group_platform_administrator'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_university_users_university" model="ir.rule">
        <field name="name">University users: assigned universities</field>
        <field name="model_id" ref="model_internship_university"/>
        <field name="groups" eval="[(4, ref('group_university_administrator')), (4, ref('group_university_staff'))]"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
    </record>

    <record id="rule_platform_company_all" model="ir.rule">
        <field name="name">Platform administrators: all companies</field>
        <field name="model_id" ref="model_internship_company"/>
