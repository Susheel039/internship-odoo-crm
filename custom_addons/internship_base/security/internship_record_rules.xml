    </record>
    <record id="rule_company_users_company" model="ir.rule">
        <field name="name">Company users: assigned companies</field>
        <field name="model_id" ref="model_internship_company"/>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_university_users_company" model="ir.rule">
        <field name="name">University users: companies with assigned programs</field>
        <field name="model_id" ref="model_internship_company"/>
        <field name="groups" eval="[(4, ref('group_university_administrator')), (4, ref('group_university_staff'))]"/>
        <field name="domain_force">[('opportunity_ids.program_id.university_id.user_ids', 'in', user.id)]</field>
    </record>

    <record id="rule_platform_student_all" model="ir.rule">
        <field name="name">Platform administrators: all students</field>
