<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_internship_management" model="ir.module.category">
        <field name="name">Internship Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_internship_management" model="res.groups.privilege">
        <field name="name">Internship Management</field>
        <field name="category_id" ref="module_category_internship_management"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_platform_administrator" model="res.groups">
        <field name="name">Platform Administrator</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
    </record>

    <record id="group_university_administrator" model="res.groups">
        <field name="name">University Administrator</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>

    <record id="group_university_staff" model="res.groups">
        <field name="name">University Staff</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>

    <record id="group_company_manager" model="res.groups">
        <field name="name">Company Manager</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
    </record>

    <record id="group_student" model="res.groups">
        <field name="name">Student</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
    </record>

    <record id="group_line_manager" model="res.groups">
        <field name="name">Line Manager</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
        <field name="comment">Company supervisor of one or more placements. Can later be a portal user.</field>
    </record>

    <record id="group_crm_agent" model="res.groups">
        <field name="name">Call Centre / CRM Agent</field>
        <field name="privilege_id" ref="privilege_internship_management"/>
        <field name="comment">Works leads and call logs only; read-only access to master data.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_platform_administrator'))]"/>
    </record>
</odoo>
