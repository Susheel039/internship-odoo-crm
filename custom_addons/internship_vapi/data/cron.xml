<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_vapi_call_queue" model="ir.cron">
        <field name="name">Internship: Voice AI call queue</field>
        <field name="model_id" ref="model_internship_call_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_dial_queue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="config_vapi_enabled" model="ir.config_parameter">
        <field name="key">internship_vapi.enabled</field>
        <field name="value">False</field>
    </record>
</odoo>
