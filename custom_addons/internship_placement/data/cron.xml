<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_placement_reminders" model="ir.cron">
        <field name="name">Internship: form and document request reminders</field>
        <field name="model_id" ref="model_internship_placement"/>
        <field name="state">code</field>
        <field name="code">model._cron_form_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_placement_start_end" model="ir.cron">
        <field name="name">Internship: start and end placements</field>
        <field name="model_id" ref="model_internship_placement"/>
        <field name="state">code</field>
        <field name="code">model._cron_start_end()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_document_expiry" model="ir.cron">
        <field name="name">Internship: expire documents</field>
        <field name="model_id" ref="model_internship_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
