<?xml version="1.0" encoding="utf-8"?>
<!-- Placement smart buttons on master data -->
<odoo>
    <record id="view_internship_student_form_placement" model="ir.ui.view">
        <field name="name">internship.student.form.placement</field>
        <field name="model">internship.student</field>
        <field name="inherit_id" ref="internship_base.view_internship_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(internship_placement.action_internship_invite_company_wizard)d" type="action"
                        string="Self-sourced Placement" context="{'default_student_id': id}" invisible="active_placement_id"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_placements" type="object" class="oe_stat_button" icon="fa-briefcase">
                    <field name="placement_count" widget="statinfo" string="Placements"/>
                </button>
            </div>
            <field name="academic_tutor_id" position="after">
                <field name="active_placement_id"/>
            </field>
        </field>
    </record>

    <record id="view_internship_company_form_placement" model="ir.ui.view">
        <field name="name">internship.company.form.placement</field>
        <field name="model">internship.company</field>
        <field name="inherit_id" ref="internship_base.view_internship_company_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_placements" type="object" class="oe_stat_button" icon="fa-briefcase">
                    <field name="placement_count" widget="statinfo" string="Placements"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_internship_line_manager_form_placement" model="ir.ui.view">
        <field name="name">internship.line.manager.form.placement</field>
        <field name="model">internship.line.manager</field>
        <field name="inherit_id" ref="internship_base.view_internship_line_manager_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_placements" type="object" class="oe_stat_button" icon="fa-briefcase">
                    <field name="placement_count" widget="statinfo" string="Placements"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_internship_application_form_placement" model="ir.ui.view">
        <field name="name">internship.application.form.placement</field>
        <field name="model">internship.application</field>
        <field name="inherit_id" ref="internship_base.view_internship_application_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_placement" type="object" class="oe_stat_button" icon="fa-briefcase"
                        invisible="not placement_id" string="Placement"/>
            </div>
            <field name="university_id" position="after">
                <field name="placement_id"/>
            </field>
        </field>
    </record>
</odoo>
