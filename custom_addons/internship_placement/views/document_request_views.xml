<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_document_request_list" model="ir.ui.view">
        <field name="name">internship.document.request.list</field>
        <field name="model">internship.document.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'" decoration-success="state == 'complete'">
                <field name="name"/>
                <field name="placement_id"/>
                <field name="student_id"/>
                <field name="internship_company_id" optional="show"/>
                <field name="round_no" optional="hide"/>
                <field name="requested_from"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_internship_document_request_form" model="ir.ui.view">
        <field name="name">internship.document.request.form</field>
        <field name="model">internship.document.request</field>
        <field name="arch" type="xml">
            <form string="Document Request">
                <header>
                    <button name="action_send" type="object" string="Send Again" invisible="state == 'complete'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,partial,complete"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="placement_id"/>
                            <field name="student_id"/>
                            <field name="round_no"/>
                        </group>
                        <group>
                            <field name="requested_from"/>
                            <field name="requested_by_id"/>
                            <field name="requested_date"/>
                            <field name="due_date"/>
                            <field name="completed_date" invisible="not completed_date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-success="accepted">
                            <field name="document_type_id"/>
                            <field name="description"/>
                            <field name="mandatory"/>
                            <field name="attachment_id"/>
                            <field name="uploaded_date" optional="show"/>
                            <field name="accepted"/>
                            <field name="rejection_note" optional="show"/>
                            <button name="action_accept" type="object" string="Accept" icon="fa-check"
                                    invisible="accepted or not attachment_id"/>
                            <button name="%(internship_base.action_internship_reason_wizard)d" type="action" string="Reject" icon="fa-times"
                                    invisible="accepted or not attachment_id"
                                    context="{'default_reason_type': 'document_rejection', 'default_method': 'action_reject', 'active_model': 'internship.document.request.line', 'active_ids': [id]}"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Message to the student / company"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internship_document_request_search" model="ir.ui.view">
        <field name="name">internship.document.request.search</field>
        <field name="model">internship.document.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="placement_id"/>
                <field name="student_id"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('open', 'partial', 'overdue'))]"/>
                <filter name="overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_internship_document_request" model="ir.actions.act_window">
        <field name="name">Document Requests</field>
        <field name="res_model">internship.document.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
