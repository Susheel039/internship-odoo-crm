<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_leave_list" model="ir.ui.view">
        <field name="name">internship.leave.list</field>
        <field name="model">internship.leave</field>
        <field name="arch" type="xml">
            <list>
                <field name="placement_id"/>
                <field name="student_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="days"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_internship_leave_form" model="ir.ui.view">
        <field name="name">internship.leave.form</field>
        <field name="model">internship.leave</field>
        <field name="arch" type="xml">
            <form string="Leave">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'requested'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="placement_id"/>
                            <field name="student_id"/>
                            <field name="leave_type"/>
                            <field name="evidence_attachment_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="days"/>
                            <field name="requested_date"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_internship_leave" model="ir.actions.act_window">
        <field name="name">Leave</field>
        <field name="res_model">internship.leave</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
