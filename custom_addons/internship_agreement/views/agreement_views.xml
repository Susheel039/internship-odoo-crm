<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_agreement_list" model="ir.ui.view">
        <field name="name">internship.agreement.list</field>
        <field name="model">internship.agreement</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'fully_signed'" decoration-danger="state == 'declined'" decoration-muted="state == 'voided'">
                <field name="name"/>
                <field name="placement_id"/>
                <field name="student_id"/>
                <field name="internship_company_id"/>
                <field name="version"/>
                <field name="amendment_of_id" optional="hide"/>
                <field name="generated_date" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_internship_agreement_form" model="ir.ui.view">
        <field name="name">internship.agreement.form</field>
        <field name="model">internship.agreement</field>
        <field name="arch" type="xml">
            <form string="Placement Agreement">
                <header>
                    <button name="action_send" type="object" string="Send for Signature" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_signing_page" type="object" string="Open Signing Page"
                            invisible="state not in ('sent_company', 'signed_company', 'sent_student', 'signed_student', 'awaiting_university')"/>
                    <button name="action_regenerate" type="object" string="Reissue New Version"
                            invisible="state in ('fully_signed', 'voided')"
                            confirm="Void this agreement and issue a new version for signature?"
                            groups="internship_base.group_platform_administrator,internship_base.group_university_administrator"/>
                    <button name="action_void" type="object" string="Void" invisible="state in ('fully_signed', 'voided')"
                            groups="internship_base.group_platform_administrator,internship_base.group_university_administrator"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent_company,sent_student,awaiting_university,fully_signed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="placement_id"/>
                            <field name="student_id"/>
                            <field name="internship_company_id"/>
                            <field name="version"/>
                            <field name="amendment_of_id" invisible="not amendment_of_id"/>
                            <field name="change_request_id" invisible="not change_request_id"/>
                        </group>
                        <group>
                            <field name="pdf_attachment_id"/>
                            <field name="signed_attachment_id"/>
                            <field name="pdf_sha256"/>
                            <field name="generated_date"/>
                            <field name="current_signer_id"/>
                            <field name="reminder_count"/>
                        </group>
                    </group>
                    <field name="signer_ids" readonly="1">
                        <list>
                            <field name="sequence"/>
                            <field name="role"/>
                            <field name="partner_id"/>
                            <field name="state" widget="badge" decoration-success="state == 'signed'" decoration-danger="state == 'declined'"/>
                            <field name="sent_date"/>
                            <field name="signed_name"/>
                            <field name="signed_at"/>
                            <field name="signed_ip" optional="show"/>
                            <field name="user_agent" optional="hide"/>
                        </list>
                    </field>
                    <group invisible="state != 'declined'" string="Declined">
                        <field name="declined_by_id"/>
                        <field name="decline_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internship_agreement_search" model="ir.ui.view">
        <field name="name">internship.agreement.search</field>
        <field name="model">internship.agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="placement_id"/>
                <field name="student_id"/>
                <filter name="in_signing" string="In Signing"
                        domain="[('state', 'in', ('sent_company', 'signed_company', 'sent_student', 'signed_student', 'awaiting_university'))]"/>
                <filter name="signed" string="Fully Signed" domain="[('state', '=', 'fully_signed')]"/>
                <filter name="declined" string="Declined" domain="[('state', '=', 'declined')]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_internship_agreement" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">internship.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_internship_placement_form_agreement" model="ir.ui.view">
        <field name="name">internship.placement.form.agreement</field>
        <field name="model">internship.placement</field>
        <field name="inherit_id" ref="internship_placement.view_internship_placement_form"/>
        <field name="arch" type="xml">
            <button name="action_mark_agreement_signed" position="before">
                <button name="action_generate_agreement" type="object" string="Generate Agreement" class="btn-primary"
                        invisible="stage_code != 'agreement' or agreement_id"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_agreements" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                    <field name="agreement_count" widget="statinfo" string="Agreements"/>
                </button>
            </div>
            <page name="review" position="after">
                <page string="Agreement" name="agreement">
                    <group>
                        <field name="agreement_id"/>
                    </group>
                    <field name="agreement_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="generated_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <menuitem id="menu_internship_agreements" name="Agreements" parent="internship_base.menu_internship_admissions"
              action="action_internship_agreement" sequence="50"/>
</odoo>
