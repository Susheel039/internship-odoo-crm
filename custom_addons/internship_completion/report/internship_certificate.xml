<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_internship_certificate" model="ir.actions.report">
        <field name="name">Certificate of Placement</field>
        <field name="model">internship.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">internship_completion.report_internship_certificate</field>
        <field name="report_file">internship_completion.report_internship_certificate</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" ref="model_internship_certificate"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_internship_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="p" t-value="doc.placement_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center" style="margin-top: 40px;">
                            <h1>Certificate of Placement</h1>
                            <p class="mt-4">This is to certify that</p>
                            <h2 t-out="p.student_id.name"/>
                            <p class="mt-4">has completed a work placement as</p>
                            <h3 t-out="p.role_title or ''"/>
                            <p>with <strong t-out="p.internship_company_id.name"/></p>
                            <p t-if="p.actual_start or p.planned_start">
                                from <span t-out="p.actual_start or p.planned_start" t-options="{'widget': 'date'}"/>
                                to <span t-out="p.actual_end or p.planned_end" t-options="{'widget': 'date'}"/>
                            </p>
                            <p t-if="p.program_id">as part of <t t-out="p.program_id.name"/>, <t t-out="p.university_id.name"/></p>
                            <p class="mt-5">Issued on <span t-field="doc.issue_date"/>
                                <t t-if="doc.issued_by_id"> by <t t-out="doc.issued_by_id.name"/>
                                    <t t-if="doc.issued_by_id.job_title">, <t t-out="doc.issued_by_id.job_title"/></t></t>
                            </p>
                            <p class="mt-4 text-muted">Certificate reference <t t-out="doc.name"/> · Placement <t t-out="p.name"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
