<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internship_crm_lead_kanban" model="ir.ui.view">
        <field name="name">internship.crm.lead.kanban</field>
        <field name="model">internship.crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column" create="false" edit="false">
                <field name="name"/>
                <field name="student_id"/>
                <field name="company_id"/>
                <field name="opportunity_id"/>
                <field name="lead_source"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong><field name="name"/></strong>
                            <div t-if="record.student_id.value"><field name="student_id"/></div>
                            <div t-if="record.company_id.value"><field name="company_id"/></div>
                            <div t-if="record.opportunity_id.value"><field name="opportunity_id"/></div>
                            <div class="text-muted"><field name="lead_source"/></div>
                            <field name="priority" widget="priority"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_internship_crm_lead_tree" model="ir.ui.view">
        <field name="name">internship.crm.lead.tree</field>
        <field name="model">internship.crm.lead</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="name"/>
                <field name="student_id"/>
                <field name="company_id"/>
                <field name="opportunity_id"/>
                <field name="lead_source"/>
                <field name="stage"/>
                <field name="priority"/>
                <field name="expected_start_date"/>
            </list>
        </field>
    </record>

    <record id="view_internship_crm_lead_form" model="ir.ui.view">
        <field name="name">internship.crm.lead.form</field>
        <field name="model">internship.crm.lead</field>
        <field name="arch" type="xml">
            <form string="Legacy Internship Lead" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="student_id"/>
                            <field name="company_id"/>
                            <field name="opportunity_id"/>
                            <field name="crm_id"/>
                            <field name="crm_lead_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="lead_source"/>
                            <field name="stage"/>
                            <field name="priority"/>
                            <field name="expected_start_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_internship_crm_lead" model="ir.actions.act_window">
        <field name="name">Legacy Internship Leads</field>
        <field name="res_model">internship.crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
